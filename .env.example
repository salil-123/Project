# Copy to .env and fill in. The real .env is gitignored.

# Earth Engine: the cloud project + user the app initializes against
EE_PROJECT=your-ee-project-id
EE_USER_ID=your-ee-user

# The shared model-zoo git remote that `publish` pushes cards to (optional; without it,
# publish still commits locally).
ZOO_REMOTE=https://github.com/<you>/zoo_database.git
