{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://core-stack.org/schema/dataset_card.schema.json",
  "title": "LULC Dataset Card",
  "description": "A data source for the LULC zoo. type=training -> labeled polygons/pixels a model learns from; type=inference -> the feature/input source a model consumes at runtime (no labels).",
  "type": "object",
  "required": ["id", "name", "type", "kind", "definition", "extent", "version"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "pattern": "^ds_[a-z0-9_]+_v[0-9]+$" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "type": {
      "enum": ["training", "inference"],
      "description": "training = labels/polygons (no embedding needed); inference = the input features the model runs on (no labels)."
    },
    "kind": { "enum": ["polygons", "ee_asset", "embedding_table"] },
    "classes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["class"],
        "properties": {
          "class": { "type": "string" },
          "name": { "type": "string" },
          "count": { "type": ["integer", "null"] },
          "description": { "type": "string" }
        }
      }
    },
    "definition": {
      "type": "object",
      "required": ["type"],
      "properties": { "type": { "enum": ["polygons", "ee_asset", "embedding_table"] } },
      "additionalProperties": true
    },
    "extent": { "$ref": "#/definitions/extent" },
    "embedding": { "$ref": "#/definitions/embedding" },
    "provenance": {
      "type": "object",
      "properties": {
        "annotator": { "type": "string" },
        "method": { "type": "string" },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "license": { "type": ["string", "null"] },
        "notes": { "type": "string" }
      },
      "additionalProperties": true
    },
    "quality": {
      "type": "object",
      "properties": {
        "n_polygons": { "type": ["integer", "null"] },
        "n_pixels": { "type": ["integer", "null"] },
        "occupied_cells": { "type": ["integer", "null"] },
        "spatial_diversity": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "class_balance": { "type": ["object", "null"] }
      },
      "additionalProperties": true
    },
    "version": { "type": "integer", "minimum": 1 },
    "created": { "type": "string" }
  },
  "allOf": [
    {
      "comment": "training datasets describe what classes they label",
      "if": { "properties": { "type": { "const": "training" } } },
      "then": { "required": ["classes"] }
    },
    {
      "comment": "inference datasets describe the feature space (embedding), not labels",
      "if": { "properties": { "type": { "const": "inference" } } },
      "then": { "required": ["embedding"] }
    }
  ],
  "definitions": {
    "extent": {
      "type": "object",
      "required": ["spatial"],
      "properties": {
        "spatial": {
          "type": "object",
          "required": ["type"],
          "properties": { "type": { "enum": ["bbox", "region", "polygon", "ee_asset"] } },
          "additionalProperties": true
        },
        "temporal": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true,
      "description": "Open by design. We populate bbox now ({type:'bbox', value:[w,s,e,n]}); region/polygon/ee_asset stay available. Temporal alongside; a future axis (e.g. embedding basis) is an added key, not a schema break."
    },
    "embedding": {
      "type": "object",
      "properties": {
        "source": { "type": "string" },
        "dim": { "type": "integer" },
        "year": { "type": "integer" }
      },
      "additionalProperties": true
    }
  }
}
