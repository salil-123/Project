# Copy to ../.env and fill in. NEVER commit the real .env (it holds tokens).

# --- Earth Engine ---
EE_PROJECT=modern-mystery-398416
EE_USER_ID=your-ee-user-id
# Headless / shared auth: instead of `earthengine authenticate`, use a service-account key. Mount the
# key into the container and point this at it — config.ee_init authenticates as that robot on EE_PROJECT.
# This is how someone else runs the container against OUR project without our personal login.
# EE_SERVICE_ACCOUNT_KEY=/app/ee-key.json

# --- Model zoo remote (your fork of the catalogue repo) ---
ZOO_REMOTE=https://github.com/<you>/zoo_database.git

# --- Mounts (cluster checklist #1): three separate host dirs ---
# Where the HOST keeps each one. Defaults are this checkout, which is what you want on a laptop.
# CORESTACK_CODE_HOST=/srv/corestack-lulc/code
# CORESTACK_MODELS_HOST=/srv/corestack-lulc/models
# CORESTACK_DATA_HOST=/srv/corestack-lulc/data
#
# Where the APP looks inside the container (these match the mount points above; override only if you
# mount somewhere other than /app/models and /app/data).
# CORESTACK_ROOT=/app
# CORESTACK_DATA_DIR=/app/data
# CORESTACK_MODELS_DIR=/app/models

# --- STACD output ---
# Where classified rasters are exported as GEE assets (must be a project/path you can write to):
# EE_ASSET_ROOT=projects/<your-project>/assets/corestack_lulc
# Public base URL so STAC asset/link hrefs come out absolute (a STAC browser can't resolve '/api/...'):
# STAC_ASSET_BASE=http://act4dws5/corestack-lulc

# --- Airflow job orchestration (optional) ---
# Leave AIRFLOW_API_BASE empty and jobs run inline in the backend (the app works with no Airflow).
# Set it to route the long ops through a DAG: frontend triggers a job, the DAG calls back into the
# backend to do the work, the frontend polls till done. See deploy/airflow_job_flow_plan.md.
# AIRFLOW_API_BASE=http://airflow:8080/api/v1
# AIRFLOW_USERNAME=airflow
# AIRFLOW_PASSWORD=airflow
# AIRFLOW_TOKEN=              # use instead of username/password if your Airflow is token-auth
# AIRFLOW_DAG_ID=corestack_lulc
# Full env + API details: deploy/AIRFLOW_API.md
# Where the Airflow worker reaches THIS backend to call the work endpoint + post the result back
# (not localhost unless same box): the container host / LAN IP / ngrok URL.
# CORESTACK_API_BASE=http://lulc:8000

# --- Database (cluster checklist #9) ---
# Users + projects (week 18). The central Postgres on the cluster host, never a per-project Postgres
# or a SQLite file in the container. Unset on a laptop -> data/corestack.db (SQLite), dev only.
# DATABASE_URL=postgresql://USER:PASSWORD@POSTGRES_HOST:5432/DBNAME

# --- Google sign-in (cluster checklist #4) ---
# Our OAuth client id is built into config.py, so leave this alone on the tower. A new site origin
# goes under "Authorized JavaScript origins" in the Cloud console, not here. Set it EMPTY to get the
# local "type your name" login on a laptop. The ID-token flow needs no client secret.
# GOOGLE_CLIENT_ID=
# Signs the session cookie. Any long random string, the same on every replica; never commit it.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# SESSION_SECRET=
# SESSION_DAYS=7
# Optional. Unset, the DAG's callback paths (export-asset, jobs, classify) stay open without a session,
# which is how the tower's current DAG works. Set it to lock them to the DAG: the same value goes in
# CORESTACK_SERVICE_TOKEN on the Airflow side, and the DAG sends it as X-Service-Token.
# SERVICE_TOKEN=

# --- Front page ---
# The walkthrough video: a YouTube link (embedded) or an mp4 path/URL. Empty -> the one bundled at
# src/static/media/diy_lulc_acacia.mp4 (comes with git pull). Set this only to swap it for a YouTube link.
# INTRO_VIDEO_URL=https://youtu.be/XXXXXXXXXXX

# --- Logging (cluster checklist #5) ---
# debug = request traces + job params + Airflow polling | info = startup/triggers/run ids | error = failures
# Logs go to data/logs/corestack-lulc/app.log (rotating, 10 MB x 5) AND stdout. Tail them with:
#   docker compose -f docker-compose.hub.yml logs -f lulc
#   tail -f data/logs/corestack-lulc/app.log
LOG_LEVEL=info

# --- Frontend API base (cluster checklist #7) ---
# Where the BROWSER sends its /api calls. Leave EMPTY for the normal single-container deploy: the
# page then uses paths relative to itself, so it works at the domain root and behind a reverse-proxy
# subpath alike. Set it only to point the UI at a different backend host.
# API_BASE_URL=

# --- Optional AOI guardrails (defaults shown) ---
# AOI_TILE_CAP_KM2=40000
# AOI_GEOTIFF_CAP_KM2=250
# AOI_TESSERA_MAX_TILES=6
# SEGMENT_MIN_AREA_HA=0.5

# --- Docker Hub creds, used ONLY by deploy/build_and_push.* (keep the real values out of git) ---
docker_username=
docker_pat=
