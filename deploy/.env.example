# Copy to ../.env and fill in. NEVER commit the real .env (it holds tokens).

# --- Earth Engine ---
EE_PROJECT=modern-mystery-398416
EE_USER_ID=your-ee-user-id
# Headless / shared auth: instead of `earthengine authenticate`, use a service-account key. Mount the
# key into the container and point this at it — config.ee_init authenticates as that robot on EE_PROJECT.
# This is how someone else runs the container against OUR project without our personal login.
# EE_SERVICE_ACCOUNT_KEY=/app/ee-key.json

# --- Model zoo remote (your fork of the catalogue repo) ---
ZOO_REMOTE=https://github.com/<you>/zoo_database.git

# --- Optional: relocate the writable data dir (e.g. onto a mounted volume) ---
# CORESTACK_DATA_DIR=/app/data
# CORESTACK_ROOT=/app

# --- Optional AOI guardrails (defaults shown) ---
# AOI_TILE_CAP_KM2=40000
# AOI_GEOTIFF_CAP_KM2=600
# AOI_TESSERA_MAX_TILES=6
# SEGMENT_MIN_AREA_HA=0.5
# WATER_MIN_FORTNIGHTS=2

# --- Docker Hub creds, used ONLY by deploy/build_and_push.* (keep the real values out of git) ---
docker_username=
docker_pat=
